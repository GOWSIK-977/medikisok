# mock = canned OCR text keyed by documentType, zero setup, deterministic for demos
# tesseract = real OCR via tesseract.js (must `npm install tesseract.js` first - it's
#             an optionalDependency so a plain `npm install` won't fail without it)
OCR_PROVIDER=mock

# mock = deterministic regex/keyword extraction and templated summary text
# anthropic = real LLM calls (fill in ANTHROPIC_API_KEY and the TODOs in
#             src/llm/anthropicProvider.js)
LLM_PROVIDER=mock

ANTHROPIC_API_KEY=
PORT=4001
